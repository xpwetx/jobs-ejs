
<!DOCTYPE html>
<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<h2>Jobs List</h2>

<a href="/jobs/new"><button type="button">Add Job</button></a>

<!-- Flash messages -->
<% if (locals.error && locals.error.length > 0) { %>
  <ul>
    <% locals.error.forEach(msg => { %>
      <li style="color:red;"><%= msg %></li>
    <% }) %>
  </ul>
<% } %>

<% if (locals.info && locals.info.length > 0) { %>
  <ul>
    <% locals.info.forEach(msg => { %>
      <li style="color:green;"><%= msg %></li>
    <% }) %>
  </ul>
<% } %>

<table border="1" cellpadding="5">
  <tr>
    <th>Company</th>
    <th>Position</th>
    <th>Status</th>
    <th colspan="2">Actions</th>
  </tr>

  <% if (jobs && jobs.length > 0) { %>
    <% jobs.forEach(job => { %>
      <tr>
        <td><%= job.company %></td>
        <td><%= job.position %></td>
        <td><%= job.status %></td>
        <td>
          <a href="/jobs/edit/<%= job._id %>">
            <button type="button">edit</button>
          </a>
        </td>
        <td>
          <form method="POST" action="/jobs/delete/<%= job._id %>" style="display:inline;">
            <input type="hidden" name="_csrf" value="<%= _csrf %>" />
            <button type="submit">delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  <% } else { %>
    <tr>
      <td colspan="5">No jobs found.</td>
    </tr>
  <% } %>
</table>

<%- include("partials/footer.ejs") %>